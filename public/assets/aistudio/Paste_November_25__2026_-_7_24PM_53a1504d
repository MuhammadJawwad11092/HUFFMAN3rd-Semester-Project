namespace {
    constexpr size_t IO_CHUNK_SIZE = 65536;
    constexpr uint64_t FIXED_HEADER_SIZE = 17; // "HUF2"(4) + mode(1) + size(8) + crc32(4)

    void writeHuf2Header(BitWriter& writer, CompressionMode mode, uint64_t originalSize, uint32_t crc) {
        writer.setSection("magic");
        const uint8_t magic[4] = {'H', 'U', 'F', '2'};
        writer.writeBytesRaw(magic, 4);

        writer.setSection("mode");
        writer.writeByteRaw(static_cast<uint8_t>(mode));

        writer.setSection("size");
        writer.writeUint64LE(originalSize);

        writer.setSection("crc");
        writer.writeUint32LE(crc);
    }

    CompressionResult compressStreamCore(istream& in,
                                         ostream& out,
                                         CompressionMode mode,
                                         TraceLogger* logger) {
        CompressionResult res;
        res.modeRequested = mode;
        res.modeUsed = mode;
        res.headerBytes = FIXED_HEADER_SIZE;

        auto tStart = chrono::steady_clock::now();

        // Pass 1: 64 KB chunked scan to compute originalSize, byte frequencies, and CRC32
        uint64_t freq[256] = {0};
        uint64_t originalSize = 0;
        uint32_t crcState = crc32_init();
        vector<uint8_t> chunk(IO_CHUNK_SIZE);

        in.clear();
        in.seekg(0, ios::beg);
        while (true) {
            in.read(reinterpret_cast<char*>(chunk.data()), static_cast<streamsize>(chunk.size()));
            streamsize got = in.gcount();
            if (got <= 0) break;
            for (streamsize i = 0; i < got; i++) {
                freq[chunk[static_cast<size_t>(i)]]++;
            }
            crcState = crc32_update(crcState, chunk.data(), static_cast<size_t>(got));
            originalSize += static_cast<uint64_t>(got);
        }

        uint32_t finalCrc = crc32_finalize(crcState);
        res.originalSize = originalSize;
        res.crc32 = finalCrc;

        BitWriter writer(out, logger);

        // Edge case: Empty file
        if (originalSize == 0) {
            res.modeUsed = CompressionMode::RAW_BYPASS;
            writeHuf2Header(writer, CompressionMode::RAW_BYPASS, 0, finalCrc);
            writer.finish();
            res.compressedSize = writer.getBytesWritten();
            res.success = true;
            auto tEnd = chrono::steady_clock::now();
            res.durationMs = chrono::duration<double, milli>(tEnd - tStart).count();
            return res;
        }

        writeHuf2Header(writer, mode, originalSize, finalCrc);

        // Reset stream for encoding pass
        in.clear();
        in.seekg(0, ios::beg);

        if (mode == CompressionMode::RAW_BYPASS) {
            writer.setSection("payload");
            while (true) {
                in.read(reinterpret_cast<char*>(chunk.data()), static_cast<streamsize>(chunk.size()));
                streamsize got = in.gcount();
                if (got <= 0) break;
                writer.writeBytesRaw(chunk.data(), static_cast<size_t>(got));
            }
            res.treeHeaderBytes = 0;
            res.payloadBytes = originalSize;
        } else if (mode == CompressionMode::STATIC_HUFFMAN) {
            Node* root = buildHuffmanTree(freq, 256, logger);
            string codes[256];
            generateCodes(root, "", codes, logger);

            uint64_t beforeTree = writer.getBytesWritten();
            writer.setSection("tree");
            serializeHuffmanTree(root, writer);
            uint64_t afterTree = writer.getBytesWritten();
            res.treeHeaderBytes = afterTree - beforeTree;

            // Single unique byte requires 0 payload bits (leaf character + originalSize suffices)
            if (!root->isLeaf()) {
                writer.setSection("payload");
                while (true) {
                    in.read(reinterpret_cast<char*>(chunk.data()), static_cast<streamsize>(chunk.size()));
                    streamsize got = in.gcount();
                    if (got <= 0) break;
                    for (streamsize i = 0; i < got; i++) {
                        uint8_t b = chunk[static_cast<size_t>(i)];
                        writer.writeCodeString(codes[b], b);
                    }
                }
            }
            writer.flushBits();
            res.payloadBytes = writer.getBytesWritten() - afterTree;
            deleteHuffmanTree(root);
        } else if (mode == CompressionMode::CANONICAL_HUFFMAN) {
            Node* root = buildHuffmanTree(freq, 256, logger);
            uint8_t lengths[256] = {0};
            uint32_t codes[256] = {0};
            computeTreeBitLengths(root, lengths);
            bool singleSymbol = root->isLeaf();
            deleteHuffmanTree(root);

            limitBitLengths(lengths, 256, 30);
            assignCanonicalCodes(lengths, 256, codes);

            if (logger && logger->enabled) {
                for (int i = 0; i < 256; i++) {
                    if (lengths[i] > 0) {
                        logger->registerCode(i, freq[i], canonicalCodeToString(codes[i], lengths[i]));
                    }
                }
            }

            uint64_t beforeTree = writer.getBytesWritten();
            writer.setSection("tree");
            writeCanonicalHeader(writer, lengths, 256);
            uint64_t afterTree = writer.getBytesWritten();
            res.treeHeaderBytes = afterTree - beforeTree;

            if (!singleSymbol) {
                writer.setSection("payload");
                while (true) {
                    in.read(reinterpret_cast<char*>(chunk.data()), static_cast<streamsize>(chunk.size()));
                    streamsize got = in.gcount();
                    if (got <= 0) break;
                    for (streamsize i = 0; i < got; i++) {
                        uint8_t b = chunk[static_cast<size_t>(i)];
                        writer.writeBits(codes[b], lengths[b], b, canonicalCodeToString(codes[b], lengths[b]));
                    }
                }
            }
            writer.flushBits();
            res.payloadBytes = writer.getBytesWritten() - afterTree;
        } else if (mode == CompressionMode::ADAPTIVE_FGK) {
            AdaptiveHuffmanTree fgk;
            res.treeHeaderBytes = 0; // Zero tree header overhead!
            uint64_t beforePayload = writer.getBytesWritten();
            writer.setSection("payload");
            while (true) {
                in.read(reinterpret_cast<char*>(chunk.data()), static_cast<streamsize>(chunk.size()));
                streamsize got = in.gcount();
                if (got <= 0) break;
                for (streamsize i = 0; i < got; i++) {
                    fgk.encodeByte(chunk[static_cast<size_t>(i)], writer, logger);
                }
            }
            writer.flushBits();
            res.payloadBytes = writer.getBytesWritten() - beforePayload;
        } else if (mode == CompressionMode::LZ77_HUFFMAN) {
            uint64_t beforeBlocks = writer.getBytesWritten();
            vector<LZ77Token> tokens;
            while (true) {
                in.read(reinterpret_cast<char*>(chunk.data()), static_cast<streamsize>(chunk.size()));
                streamsize got = in.gcount();
                if (got <= 0) break;
                LZ77Engine::tokenizeBlock(chunk.data(), static_cast<size_t>(got), tokens);
                LZ77Engine::encodeBlock(tokens, writer, logger);
            }
            writer.flushBits();
            uint64_t totalBody = writer.getBytesWritten() - beforeBlocks;
            res.treeHeaderBytes = 0;
            res.payloadBytes = totalBody;
        }

        writer.finish();
        res.compressedSize = writer.getBytesWritten();
        res.success = true;

        auto tEnd = chrono::steady_clock::now();
        res.durationMs = chrono::duration<double, milli>(tEnd - tStart).count();
        return res;
    }
}

bool compressFile(const string& input_file_path, const string& output_file_path) {
    CompressionResult r = compressFileEx(
        input_file_path, output_file_path, CompressionMode::CANONICAL_HUFFMAN, true, nullptr);
    return r.success;
}

CompressionResult compressBuffer(const vector<uint8_t>& inputData,
                                 vector<uint8_t>& outputData,
                                 CompressionMode mode,
                                 bool allowSmartBypass,
                                 TraceLogger* logger) {
    string inStr(reinterpret_cast<const char*>(inputData.data()), inputData.size());
    istringstream inStream(inStr, ios::binary);

    if (mode == CompressionMode::AUTO_BEST) {
        CompressionMode candidates[] = {
            CompressionMode::LZ77_HUFFMAN,
            CompressionMode::CANONICAL_HUFFMAN,
            CompressionMode::STATIC_HUFFMAN,
            CompressionMode::ADAPTIVE_FGK
        };
        CompressionResult bestRes;
        vector<uint8_t> bestBuf;
        bool hasBest = false;

        for (CompressionMode m : candidates) {
            inStream.clear();
            inStream.seekg(0, ios::beg);
            ostringstream outStream(ios::binary);
            CompressionResult cur = compressStreamCore(inStream, outStream, m, nullptr);
            if (cur.success && (!hasBest || cur.compressedSize < bestRes.compressedSize)) {
                hasBest = true;
                bestRes = cur;
                string s = outStream.str();
                bestBuf.assign(s.begin(), s.end());
            }
        }

        if (allowSmartBypass && bestRes.compressedSize >= inputData.size() + FIXED_HEADER_SIZE) {
            if (logger) logger->clear();
            inStream.clear();
            inStream.seekg(0, ios::beg);
            ostringstream rawOut(ios::binary);
            bestRes = compressStreamCore(inStream, rawOut, CompressionMode::RAW_BYPASS, logger);
            bestRes.smartBypassTriggered = true;
            string s = rawOut.str();
            outputData.assign(s.begin(), s.end());
            return bestRes;
        }

        // Re-run winning mode with logger if trace requested
        if (logger && logger->enabled) {
            logger->clear();
            inStream.clear();
            inStream.seekg(0, ios::beg);
            ostringstream tracedOut(ios::binary);
            bestRes = compressStreamCore(inStream, tracedOut, bestRes.modeUsed, logger);
            string s = tracedOut.str();
            outputData.assign(s.begin(), s.end());
            return bestRes;
        }

        outputData = std::move(bestBuf);
        return bestRes;
    }

    ostringstream outStream(ios::binary);
    CompressionResult res = compressStreamCore(inStream, outStream, mode, logger);
    string s = outStream.str();

    // Smart Bypass: if algorithm overhead + payload >= original payload + fixed header, store Raw Bypass
    if (allowSmartBypass &&
        mode != CompressionMode::RAW_BYPASS &&
        res.originalSize > 0 &&
        res.compressedSize >= res.originalSize + FIXED_HEADER_SIZE) {
        if (logger) logger->clear();
        inStream.clear();
        inStream.seekg(0, ios::beg);
        ostringstream rawOut(ios::binary);
        res = compressStreamCore(inStream, rawOut, CompressionMode::RAW_BYPASS, logger);
        res.modeRequested = mode;
        res.smartBypassTriggered = true;
        s = rawOut.str();
    }

    outputData.assign(s.begin(), s.end());
    return res;
}

CompressionResult compressFileEx(const string& inputPath,
                                 const string& outputPath,
                                 CompressionMode mode,
                                 bool allowSmartBypass,
                                 TraceLogger* logger) {
    CompressionResult fail;
    ifstream inFile(inputPath, ios::binary);
    if (!inFile.is_open()) {
        fail.errorMessage = "Could not open input file: " + inputPath;
        return fail;
    }

    if (mode == CompressionMode::AUTO_BEST) {
        CompressionMode candidates[] = {
            CompressionMode::LZ77_HUFFMAN,
            CompressionMode::CANONICAL_HUFFMAN,
            CompressionMode::STATIC_HUFFMAN,
            CompressionMode::ADAPTIVE_FGK
        };
        CompressionMode bestMode = CompressionMode::CANONICAL_HUFFMAN;
        uint64_t bestSize = UINT64_MAX;
        for (CompressionMode m : candidates) {
            inFile.clear();
            inFile.seekg(0, ios::beg);
            ostringstream probe(ios::binary);
            CompressionResult cur = compressStreamCore(inFile, probe, m, nullptr);
            if (cur.success && cur.compressedSize < bestSize) {
                bestSize = cur.compressedSize;
                bestMode = m;
            }
        }
        mode = bestMode;
    }

    ofstream outFile(outputPath, ios::binary);
    if (!outFile.is_open()) {
        fail.errorMessage = "Could not open output file: " + outputPath;
        return fail;
    }

    inFile.clear();
    inFile.seekg(0, ios::beg);
    CompressionResult res = compressStreamCore(inFile, outFile, mode, logger);
    outFile.close();

    // Smart Bypass if compressed output didn't beat raw payload + 17-byte header
    if (allowSmartBypass &&
        mode != CompressionMode::RAW_BYPASS &&
        res.originalSize > 0 &&
        res.compressedSize >= res.originalSize + FIXED_HEADER_SIZE) {
        if (logger) logger->clear();
        inFile.clear();
        inFile.seekg(0, ios::beg);
        ofstream rawOut(outputPath, ios::binary | ios::trunc);
        if (rawOut.is_open()) {
            res = compressStreamCore(inFile, rawOut, CompressionMode::RAW_BYPASS, logger);
            res.modeRequested = mode;
            res.smartBypassTriggered = true;
            rawOut.close();
        }
    }

    return res;
}
