#pragma once
#include "BitStream.h"
#include "TraceLogger.h"
#include <cstdint>
#include <string>
#include <vector>

// Single-pass Adaptive FGK (Faller-Gallager-Knuth) Huffman Tree
// Maintains a weight-ordered node list (Sibling Property) in O(N) over <= 513 nodes.
class AdaptiveHuffmanTree {
private:
    static constexpr int MAX_NODES = 513; // 256 leaves + 1 NYT + 256 internal nodes
    static constexpr int SYM_NYT = 256;
    static constexpr int SYM_INTERNAL = -1;

    struct FGKNode {
        int id = 0;
        int symbol = SYM_INTERNAL;
        uint64_t weight = 0;
        int order = 0; // Root = highest order; strictly decreasing BFS right-to-left
        FGKNode* parent = nullptr;
        FGKNode* left = nullptr;
        FGKNode* right = nullptr;
    };

    FGKNode pool[MAX_NODES];
    int poolUsed;
    FGKNode* root;
    FGKNode* nyt;
    FGKNode* leaves[256];
    std::vector<FGKNode*> orderList; // Sorted by order descending (root at index 0)

    FGKNode* allocNode(int symbol, uint64_t weight);
    void rebuildOrderList();
    FGKNode* findBlockLeader(FGKNode* node) const;
    void swapNodes(FGKNode* a, FGKNode* b);
    std::string getCodeToNode(const FGKNode* target) const;

public:
    AdaptiveHuffmanTree();
    void reset();

    void update(uint8_t byteVal, TraceLogger* logger = nullptr);
    void encodeByte(uint8_t byteVal, BitWriter& writer, TraceLogger* logger = nullptr);
    bool decodeByte(BitReader& reader, uint8_t& outByte, TraceLogger* logger = nullptr);
};
