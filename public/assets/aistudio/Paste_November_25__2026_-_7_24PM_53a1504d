#### `BitStream.cpp`
```cpp
#include "BitStream.h"
#include <algorithm>
#include <cstring>

BitWriter::BitWriter(std::ostream& outStream, TraceLogger* traceLogger)
    : out(outStream),
      buffer(CHUNK_SIZE),
      bufPos(0),
      bitBuffer(0),
      bitCount(0),
      bytesWritten(0),
      logger(traceLogger),
      activeSection("payload") {}

BitWriter::~BitWriter() {
    // Caller should explicitly call finish(); safeguard flush only if bits already aligned
    if (bufPos > 0) {
        flushBuffer();
    }
}

void BitWriter::setSection(const std::string& sec) {
    activeSection = sec;
}

void BitWriter::flushBuffer() {
    if (bufPos > 0) {
        out.write(reinterpret_cast<const char*>(buffer.data()), static_cast<std::streamsize>(bufPos));
        bufPos = 0;
    }
}

void BitWriter::writeByteRaw(uint8_t b) {
    if (logger && logger->enabled) {
        logger->recordHexByte(b, activeSection);
        logger->logBitFlush(b, activeSection);
    }
    buffer[bufPos++] = b;
    bytesWritten++;
    if (bufPos == buffer.size()) {
        flushBuffer();
    }
}

void BitWriter::writeBytesRaw(const uint8_t* data, size_t len) {
    if (bitCount > 0) {
        flushBits();
    }
    if (logger && logger->enabled) {
        for (size_t i = 0; i < len; i++) {
            logger->recordHexByte(data[i], activeSection);
        }
    }
    size_t offset = 0;
    while (offset < len) {
        size_t space = buffer.size() - bufPos;
        size_t copyCount = std::min(space, len - offset);
        std::memcpy(buffer.data() + bufPos, data + offset, copyCount);
        bufPos += copyCount;
        offset += copyCount;
        bytesWritten += copyCount;
        if (bufPos == buffer.size()) {
            flushBuffer();
        }
    }
}

void BitWriter::writeUint32LE(uint32_t v) {
    uint8_t bytes[4] = {
        static_cast<uint8_t>(v & 0xFF),
        static_cast<uint8_t>((v >> 8) & 0xFF),
        static_cast<uint8_t>((v >> 16) & 0xFF),
        static_cast<uint8_t>((v >> 24) & 0xFF)
    };
    writeBytesRaw(bytes, 4);
}

void BitWriter::writeUint64LE(uint64_t v) {
    uint8_t bytes[8];
    for (int i = 0; i < 8; i++) {
        bytes[i] = static_cast<uint8_t>((v >> (i * 8)) & 0xFF);
    }
    writeBytesRaw(bytes, 8);
}

void BitWriter::writeBit(int bit, int symHint, const std::string& codeHint) {
    int b = bit & 1;
    bitBuffer = static_cast<uint8_t>((bitBuffer << 1) | b);
    bitCount++;

    if (logger && logger->enabled) {
        logger->logBitPush(b, bitBuffer, bitCount, symHint, codeHint);
    }

    if (bitCount == 8) {
        writeByteRaw(bitBuffer);
        bitBuffer = 0;
        bitCount = 0;
    }
}

void BitWriter::writeBits(uint32_t value, int numBits, int symHint, const std::string& codeHint) {
    for (int i = numBits - 1; i >= 0; i--) {
        writeBit(static_cast<int>((value >> i) & 1u), symHint, codeHint);
    }
}

void BitWriter::writeBitsLSB(uint32_t value, int numBits) {
    for (int i = 0; i < numBits; i++) {
        writeBit(static_cast<int>((value >> i) & 1u));
    }
}

void BitWriter::writeCodeString(const std::string& code, int symHint) {
    for (char ch : code) {
        writeBit(ch == '1' ? 1 : 0, symHint, code);
    }
}

void BitWriter::flushBits() {
    if (bitCount > 0) {
        bitBuffer = static_cast<uint8_t>(bitBuffer << (8 - bitCount));
        writeByteRaw(bitBuffer);
        bitBuffer = 0;
        bitCount = 0;
    }
}

void BitWriter::finish() {
    flushBits();
    flushBuffer();
    out.flush();
}

// ============================================================================
// BitReader
// ============================================================================

BitReader::BitReader(std::istream& inStream)
    : in(inStream),
      buffer(CHUNK_SIZE),
      bufPos(0),
      bufLen(0),
      curByte(0),
      bitsRemaining(0) {}

bool BitReader::refill() {
    in.read(reinterpret_cast<char*>(buffer.data()), static_cast<std::streamsize>(buffer.size()));
    bufLen = static_cast<size_t>(in.gcount());
    bufPos = 0;
    return bufLen > 0;
}

bool BitReader::readByteRaw(uint8_t& out) {
    bitsRemaining = 0;
    if (bufPos >= bufLen && !refill()) {
        return false;
    }
    out = buffer[bufPos++];
    return true;
}

bool BitReader::readBytesRaw(uint8_t* dst, size_t len) {
    bitsRemaining = 0;
    size_t offset = 0;
    while (offset < len) {
        if (bufPos >= bufLen && !refill()) {
            return false;
        }
        size_t avail = bufLen - bufPos;
        size_t take = std::min(avail, len - offset);
        std::memcpy(dst + offset, buffer.data() + bufPos, take);
        bufPos += take;
        offset += take;
    }
    return true;
}

bool BitReader::readUint32LE(uint32_t& out) {
    uint8_t b[4];
    if (!readBytesRaw(b, 4)) return false;
    out = static_cast<uint32_t>(b[0]) |
          (static_cast<uint32_t>(b[1]) << 8) |
          (static_cast<uint32_t>(b[2]) << 16) |
          (static_cast<uint32_t>(b[3]) << 24);
    return true;
}

bool BitReader::readUint64LE(uint64_t& out) {
    uint8_t b[8];
    if (!readBytesRaw(b, 8)) return false;
    out = 0;
    for (int i = 0; i < 8; i++) {
        out |= (static_cast<uint64_t>(b[i]) << (i * 8));
    }
    return true;
}

bool BitReader::readBit(int& bit) {
    if (bitsRemaining == 0) {
        if (bufPos >= bufLen && !refill()) {
            return false;
        }
        curByte = buffer[bufPos++];
        bitsRemaining = 8;
    }
    bitsRemaining--;
    bit = (curByte >> bitsRemaining) & 1;
    return true;
}

bool BitReader::readBits(int numBits, uint32_t& outVal) {
    outVal = 0;
    for (int i = 0; i < numBits; i++) {
        int b = 0;
        if (!readBit(b)) return false;
        outVal = (outVal << 1) | static_cast<uint32_t>(b);
    }
    return true;
}

bool BitReader::readBitsLSB(int numBits, uint32_t& outVal) {
    outVal = 0;
    for (int i = 0; i < numBits; i++) {
        int b = 0;
        if (!readBit(b)) return false;
        outVal |= (static_cast<uint32_t>(b) << i);
    }
    return true;
}
