static void printBenchmarkTable(const string& title, const vector<BenchmarkRow>& rows) {
    cout << "\n--- Benchmark: " << title << " ---\n";
    cout << left << setw(28) << "Algorithm"
         << right << setw(12) << "Orig(B)"
         << setw(12) << "Comp(B)"
         << setw(10) << "Ratio%"
         << setw(10) << "Hdr(B)"
         << setw(10) << "Comp(ms)"
         << setw(10) << "Dec(ms)"
         << "  CRC32\n";
    cout << string(98, '-') << "\n";

    for (const auto& r : rows) {
        cout << left << setw(28) << r.modeName
             << right << setw(12) << r.originalSize
             << setw(12) << r.compressedSize
             << setw(9) << fixed << setprecision(2) << r.ratioPercent << "%"
             << setw(10) << r.headerOverhead
             << setw(10) << fixed << setprecision(2) << r.compressMs
             << setw(10) << fixed << setprecision(2) << r.decompressMs
             << "  " << (r.crcVerified && r.roundtripMatch ? "PASS" : "FAIL")
             << (r.bypassRecommended ? " [Bypass]" : "")
             << "\n";
    }
}

int main(int argc, char* argv[]) {
    // Optional CLI shortcuts: --serve or --bench
    if (argc >= 2) {
        string arg = argv[1];
        if (arg == "--serve") {
            startWebServer(8080);
            return 0;
        }
        if (arg == "--bench") {
            const char* presets[] = {"logs", "dna", "json", "english"};
            for (const char* p : presets) {
                auto data = BenchmarkSuite::generateDataset(p, 64 * 1024);
                auto rows = BenchmarkSuite::runAllModes(data);
                printBenchmarkTable(string(p) + " (64 KB)", rows);
            }
            return 0;
        }
    }

    int choice = 0;
    string inputFile, outputFile;
    cout << "===== HUFFMAN COMPRESSION ENGINE v2 (HUF2) =====\n";

    do {
        cout << "\n1. Compress a file (HUF2 + CRC32 + Smart Bypass)\n";
        cout << "2. Decompress a file (HUF2 + CRC32 verification)\n";
        cout << "3. Run Real-World Benchmark Suite (Logs, DNA, JSON, English)\n";
        cout << "4. Launch X-Ray Web Visualizer (http://localhost:8080)\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        if (!(cin >> choice)) {
            cin.clear();
            cin.ignore(10000, '\n');
            continue;
        }

        if (choice == 5) {
            cout << "Exiting program.\n";
            break;
        }

        if (choice == 1) {
            int algoChoice = 255;
            cout << "Select Compression Mode:\n"
                 << "  0 = Raw Bypass\n"
                 << "  1 = Static Huffman (Preorder Tree)\n"
                 << "  2 = Canonical Huffman (Bit-Lengths Header)\n"
                 << "  3 = Adaptive FGK Huffman (Single-Pass)\n"
                 << "  4 = LZ77 + Canonical Huffman (DEFLATE-lite)\n"
                 << "  5 = Auto-Best (Picks smallest + Smart Bypass)\n"
                 << "Mode: ";
            cin >> algoChoice;
            CompressionMode mode = (algoChoice == 5)
                ? CompressionMode::AUTO_BEST
                : static_cast<CompressionMode>(algoChoice);

            cout << "Enter input file path: ";
            cin >> inputFile;
            cout << "Enter output file path: ";
            cin >> outputFile;

            CompressionResult res = compressFileEx(inputFile, outputFile, mode, true, nullptr);
            if (res.success) {
                double ratio = res.originalSize == 0 ? 100.0
                    : (100.0 * static_cast<double>(res.compressedSize) / static_cast<double>(res.originalSize));
                cout << "\nCompression succeeded!\n"
                     << "  Mode Used:       " << modeToString(res.modeUsed)
                     << (res.smartBypassTriggered ? " (Smart Bypass Triggered)" : "") << "\n"
                     << "  Original Size:   " << res.originalSize << " bytes\n"
                     << "  Compressed Size: " << res.compressedSize << " bytes ("
                     << fixed << setprecision(2) << ratio << "%)\n"
                     << "  CRC32 Checksum:  0x" << hex << uppercase << setw(8) << setfill('0') << res.crc32 << dec << setfill(' ') << "\n"
                     << "  Elapsed Time:    " << fixed << setprecision(2) << res.durationMs << " ms\n";
            } else {
                cout << "\nCompression failed: " << res.errorMessage << "\n";
            }
        } else if (choice == 2) {
            cout << "Enter compressed (.huf) file path: ";
            cin >> inputFile;
            cout << "Enter output file path: ";
            cin >> outputFile;

            DecompressionResult res = decompressFileEx(inputFile, outputFile, nullptr);
            if (res.success) {
                cout << "\nDecompression succeeded!\n"
                     << "  Detected Mode:  " << modeToString(res.modeDetected) << "\n"
                     << "  Restored Size:  " << res.originalSize << " bytes\n"
                     << "  CRC32 Status:   VERIFIED (0x" << hex << uppercase << setw(8) << setfill('0') << res.computedCrc32 << dec << setfill(' ') << ")\n"
                     << "  Elapsed Time:   " << fixed << setprecision(2) << res.durationMs << " ms\n";
            } else {
                cout << "\nDecompression failed: " << res.errorMessage << "\n";
            }
        } else if (choice == 3) {
            const char* presets[] = {"logs", "dna", "json", "english"};
            for (const char* p : presets) {
                auto data = BenchmarkSuite::generateDataset(p, 64 * 1024);
                auto rows = BenchmarkSuite::runAllModes(data);
                printBenchmarkTable(string(p) + " (64 KB)", rows);
            }
        } else if (choice == 4) {
            startWebServer(8080);
        } else {
            cout << "Invalid choice!\n";
        }
    } while (true);

    return 0;
}
