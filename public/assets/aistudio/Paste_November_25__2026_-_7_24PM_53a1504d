#include "HuffmanTree.h"
#include "MinHeap.h"
#include <algorithm>
#include <utility>
#include <vector>

using namespace std;

void generateCodes(Node* root, string code, string codes[], TraceLogger* logger) {
    if (root == nullptr) return;

    if (root->isLeaf()) {
        string finalCode = (code.empty()) ? "0" : code;
        codes[root->symbol] = finalCode;
        if (logger && logger->enabled) {
            logger->registerCode(root->symbol, root->freq, finalCode);
        }
        return;
    }

    generateCodes(root->left, code + '0', codes, logger);
    generateCodes(root->right, code + '1', codes, logger);
}

Node* buildHuffmanTree(const uint64_t freq[], int numSymbols, TraceLogger* logger) {
    MinHeap myMinHeap(logger);
    int localId = 1;

    for (int i = 0; i < numSymbols; i++) {
        if (freq[i] > 0) {
            int nid = (logger && logger->enabled) ? logger->nextNodeId() : localId++;
            Node* leaf = new Node(static_cast<unsigned char>(i & 0xFF), freq[i], nid, i);
            if (logger && logger->enabled) {
                logger->registerTreeNode(nid, i, freq[i], -1, -1, true);
            }
            myMinHeap.insert(leaf);
        }
    }

    if (myMinHeap.getSize() == 0) {
        return nullptr;
    }

    if (logger && logger->enabled) {
        logger->logHeapInit(myMinHeap.getSnapshot());
    }

    while (myMinHeap.getSize() > 1) {
        Node* leftNode = myMinHeap.extractMin();
        Node* rightNode = myMinHeap.extractMin();

        int pid = (logger && logger->enabled) ? logger->nextNodeId() : localId++;
        uint64_t combinedFreq = leftNode->freq + rightNode->freq;
        Node* parent = new Node('\0', combinedFreq, pid, -1);
        parent->left = leftNode;
        parent->right = rightNode;

        if (logger && logger->enabled) {
            logger->registerTreeNode(pid, -1, combinedFreq, leftNode->id, rightNode->id, false);
        }

        myMinHeap.insert(parent);

        if (logger && logger->enabled) {
            logger->logExtractMerge(leftNode->id, rightNode->id, pid, combinedFreq, myMinHeap.getSnapshot());
        }
    }

    return myMinHeap.extractMin();
}

void serializeHuffmanTree(Node* root, ofstream& out) {
    if (root == nullptr) return;

    if (root->isLeaf()) {
        out.put(1);
        out.put(static_cast<char>(root->character));
    } else {
        out.put(0);
        serializeHuffmanTree(root->left, out);
        serializeHuffmanTree(root->right, out);
    }
}

void serializeHuffmanTree(Node* root, BitWriter& writer) {
    if (root == nullptr) return;

    if (root->isLeaf()) {
        writer.writeByteRaw(1);
        writer.writeByteRaw(root->character);
    } else {
        writer.writeByteRaw(0);
        serializeHuffmanTree(root->left, writer);
        serializeHuffmanTree(root->right, writer);
    }
}

Node* deserializeHuffmanTree(BitReader& reader, TraceLogger* logger) {
    uint8_t marker = 0;
    if (!reader.readByteRaw(marker)) {
        return nullptr;
    }

    if (marker == 1) {
        uint8_t ch = 0;
        if (!reader.readByteRaw(ch)) {
            return nullptr;
        }
        int nid = (logger && logger->enabled) ? logger->nextNodeId() : 0;
        Node* leaf = new Node(ch, 0, nid, static_cast<int>(ch));
        if (logger && logger->enabled) {
            logger->registerTreeNode(nid, ch, 0, -1, -1, true);
        }
        return leaf;
    } else if (marker == 0) {
        int nid = (logger && logger->enabled) ? logger->nextNodeId() : 0;
        Node* internal = new Node('\0', 0, nid, -1);
        internal->left = deserializeHuffmanTree(reader, logger);
        internal->right = deserializeHuffmanTree(reader, logger);
        if (!internal->left || !internal->right) {
            deleteHuffmanTree(internal);
            return nullptr;
        }
        if (logger && logger->enabled) {
            logger->registerTreeNode(nid, -1, 0, internal->left->id, internal->right->id, false);
        }
        return internal;
    }
    return nullptr;
}

void deleteHuffmanTree(Node* root) {
    if (!root) return;
    deleteHuffmanTree(root->left);
    deleteHuffmanTree(root->right);
    delete root;
}

// ============================================================================
// Canonical Huffman Implementation
// ============================================================================

void computeTreeBitLengths(Node* root, uint8_t lengths[], uint8_t depth) {
    if (!root) return;
    if (root->isLeaf()) {
        lengths[root->symbol] = (depth == 0) ? 1 : depth;
        return;
    }
    computeTreeBitLengths(root->left, lengths, static_cast<uint8_t>(depth + 1));
    computeTreeBitLengths(root->right, lengths, static_cast<uint8_t>(depth + 1));
}

void limitBitLengths(uint8_t lengths[], int numSymbols, uint8_t maxBits) {
    bool needsLimit = false;
    for (int i = 0; i < numSymbols; i++) {
        if (lengths[i] > maxBits) {
            lengths[i] = maxBits;
            needsLimit = true;
        }
    }
    if (!needsLimit) return;

    // Enforce Kraft-McMillan inequality: sum(2^(maxBits - len)) <= 2^maxBits
    uint64_t maxKraft = 1ULL << maxBits;
    auto calcKraft = [&]() {
        uint64_t sum = 0;
        for (int i = 0; i < numSymbols; i++) {
            if (lengths[i] > 0) {
                sum += 1ULL << (maxBits - lengths[i]);
            }
        }
        return sum;
    };

    uint64_t kraft = calcKraft();
    while (kraft > maxKraft) {
        // Lengthen the longest code strictly shorter than maxBits
        int bestIdx = -1;
        uint8_t bestLen = 0;
        for (int i = 0; i < numSymbols; i++) {
            if (lengths[i] > 0 && lengths[i] < maxBits && lengths[i] > bestLen) {
                bestLen = lengths[i];
                bestIdx = i;
            }
        }
        if (bestIdx == -1) break;
        lengths[bestIdx]++;
        kraft -= 1ULL << (maxBits - lengths[bestIdx]);
    }
}

void assignCanonicalCodes(const uint8_t lengths[], int numSymbols, uint32_t codes[]) {
    vector<pair<uint8_t, int>> active;
    for (int i = 0; i < numSymbols; i++) {
        codes[i] = 0;
        if (lengths[i] > 0) {
            active.push_back({lengths[i], i});
        }
    }
    sort(active.begin(), active.end());

    uint32_t code = 0;
    uint8_t prevLen = 0;
    for (const auto& entry : active) {
        uint8_t len = entry.first;
        int sym = entry.second;
        if (prevLen > 0) {
            code <<= (len - prevLen);
        }
        codes[sym] = code;
        code++;
        prevLen = len;
    }
}

string canonicalCodeToString(uint32_t code, uint8_t len) {
    string s;
    s.reserve(len);
    for (int i = len - 1; i >= 0; i--) {
        s.push_back(((code >> i) & 1u) ? '1' : '0');
    }
    return s;
}

Node* buildCanonicalDecodeTree(const uint8_t lengths[], const uint32_t codes[], int numSymbols, TraceLogger* logger) {
    int rootId = (logger && logger->enabled) ? logger->nextNodeId() : 1;
    Node* root = new Node('\0', 0, rootId, -1);

    int activeCount = 0;
    int singleSym = -1;
    for (int s = 0; s < numSymbols; s++) {
        if (lengths[s] > 0) {
            activeCount++;
            singleSym = s;
        }
    }

    if (activeCount == 1) {
        root->symbol = singleSym;
        root->character = static_cast<unsigned char>(singleSym & 0xFF);
        return root;
    }

    int localId = 2;
    for (int s = 0; s < numSymbols; s++) {
        if (lengths[s] == 0) continue;
        Node* curr = root;
        for (int bitIdx = lengths[s] - 1; bitIdx >= 0; bitIdx--) {
            int bit = static_cast<int>((codes[s] >> bitIdx) & 1u);
            if (bit == 0) {
                if (!curr->left) {
                    int nid = (logger && logger->enabled) ? logger->nextNodeId() : localId++;
                    curr->left = new Node('\0', 0, nid, -1);
                }
                curr = curr->left;
            } else {
                if (!curr->right) {
                    int nid = (logger && logger->enabled) ? logger->nextNodeId() : localId++;
                    curr->right = new Node('\0', 0, nid, -1);
                }
                curr = curr->right;
            }
        }
        curr->symbol = s;
        curr->character = static_cast<unsigned char>(s & 0xFF);
    }
    return root;
}

void writeCanonicalHeader(BitWriter& writer, const uint8_t lengths[], int numSymbols) {
    int activeCount = 0;
    for (int i = 0; i < numSymbols; i++) {
        if (lengths[i] > 0) activeCount++;
    }

    // Sparse encoding when <= 127 active symbols (saves massive header overhead on text/DNA)
    if (activeCount <= 127) {
        writer.writeByteRaw(1); // Sparse mode
        writer.writeByteRaw(static_cast<uint8_t>(activeCount));
        for (int i = 0; i < numSymbols; i++) {
            if (lengths[i] > 0) {
                if (numSymbols <= 256) {
                    writer.writeByteRaw(static_cast<uint8_t>(i));
                } else {
                    writer.writeByteRaw(static_cast<uint8_t>(i & 0xFF));
                    writer.writeByteRaw(static_cast<uint8_t>((i >> 8) & 0xFF));
                }
                writer.writeByteRaw(lengths[i]);
            }
        }
    } else {
        writer.writeByteRaw(0); // Dense mode
        for (int i = 0; i < numSymbols; i++) {
            writer.writeByteRaw(lengths[i]);
        }
    }
}

bool readCanonicalHeader(BitReader& reader, uint8_t lengths[], int numSymbols) {
    for (int i = 0; i < numSymbols; i++) {
        lengths[i] = 0;
    }

    uint8_t mode = 0;
    if (!reader.readByteRaw(mode)) return false;

    if (mode == 1) {
        uint8_t count = 0;
        if (!reader.readByteRaw(count)) return false;
        for (int k = 0; k < count; k++) {
            int sym = 0;
            if (numSymbols <= 256) {
                uint8_t s = 0;
                if (!reader.readByteRaw(s)) return false;
                sym = s;
            } else {
                uint8_t lo = 0, hi = 0;
                if (!reader.readByteRaw(lo) || !reader.readByteRaw(hi)) return false;
                sym = static_cast<int>(lo) | (static_cast<int>(hi) << 8);
            }
            uint8_t len = 0;
            if (!reader.readByteRaw(len) || sym >= numSymbols) return false;
            lengths[sym] = len;
        }
        return true;
    } else if (mode == 0) {
        return reader.readBytesRaw(lengths, static_cast<size_t>(numSymbols));
    }
    return false;
}
