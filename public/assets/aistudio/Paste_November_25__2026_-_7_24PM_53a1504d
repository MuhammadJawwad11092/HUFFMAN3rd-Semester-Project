                    if (clPos != string::npos) {
                        size_t lineEnd = lower.find("\r\n", clPos);
                        string val = lower.substr(clPos + 15, lineEnd - (clPos + 15));
                        try { contentLength = static_cast<size_t>(stoul(val)); } catch (...) {}
                    }
                }
            }

            if (headerEnd != string::npos) {
                size_t bodyRead = req.size() - (headerEnd + 4);
                if (bodyRead >= contentLength) break;
            }
        }
        return req;
    }
}

void startWebServer(int port) {
#ifdef _WIN32
    WSADATA wsaData;
    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        cerr << "Error: WSAStartup failed.\n";
        return;
    }
#endif

    SocketHandle serverSock = socket(AF_INET, SOCK_STREAM, 0);
    if (serverSock == INVALID_SOCK) {
        cerr << "Error: Failed to create server socket.\n";
#ifdef _WIN32
        WSACleanup();
#endif
        return;
    }

    int opt = 1;
    setsockopt(serverSock, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&opt), sizeof(opt));

    sockaddr_in addr{};
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_ANY);
    addr.sin_port = htons(static_cast<uint16_t>(port));

    if (::bind(serverSock, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
        cerr << "Error: Could not bind to port " << port << ".\n";
        closeSock(serverSock);
#ifdef _WIN32
        WSACleanup();
#endif
        return;
    }

    if (listen(serverSock, 16) < 0) {
        cerr << "Error: listen() failed.\n";
        closeSock(serverSock);
#ifdef _WIN32
        WSACleanup();
#endif
        return;
    }

    cout << "\n==========================================================\n";
    cout << "  HUF2 X-Ray Visualizer Server running on:\n";
    cout << "  --> http://localhost:" << port << "\n";
    cout << "  Press Ctrl+C in terminal to stop the server.\n";
    cout << "==========================================================\n\n";

    while (true) {
        sockaddr_in clientAddr{};
        socklen_t clientLen = sizeof(clientAddr);
        SocketHandle clientSock = accept(serverSock, reinterpret_cast<sockaddr*>(&clientAddr), &clientLen);
        if (clientSock == INVALID_SOCK) continue;

        string rawReq = readHttpRequest(clientSock);
        if (!rawReq.empty()) {
            size_t lineEnd = rawReq.find("\r\n");
            string reqLine = (lineEnd != string::npos) ? rawReq.substr(0, lineEnd) : rawReq;
            istringstream lineStream(reqLine);
            string method, path;
            lineStream >> method >> path;

            size_t headerEnd = rawReq.find("\r\n\r\n");
            string body = (headerEnd != string::npos) ? rawReq.substr(headerEnd + 4) : "";

            if (method == "OPTIONS") {
                sendHttpResponse(clientSock, "204 No Content", "text/plain", "");
            } else if (method == "GET" && (path == "/" || path == "/index.html")) {
                sendHttpResponse(clientSock, "200 OK", "text/html; charset=utf-8", loadIndexHtml());
            } else if (method == "POST" && path == "/api/xray") {
                sendHttpResponse(clientSock, "200 OK", "application/json", handleXrayApi(body));
            } else if (method == "POST" && path == "/api/benchmark") {
                sendHttpResponse(clientSock, "200 OK", "application/json", handleBenchmarkApi(body));
            } else {
                sendHttpResponse(clientSock, "404 Not Found", "text/plain", "404 Not Found");
            }
        }
        closeSock(clientSock);
    }

    closeSock(serverSock);
#ifdef _WIN32
    WSACleanup();
#endif
}
