        case CompressionMode::RAW_BYPASS:        return "Mode 0: Raw Bypass";
        case CompressionMode::STATIC_HUFFMAN:    return "Mode 1: Static Huffman";
        case CompressionMode::CANONICAL_HUFFMAN: return "Mode 2: Canonical Huffman";
        case CompressionMode::ADAPTIVE_FGK:      return "Mode 3: Adaptive FGK";
        case CompressionMode::LZ77_HUFFMAN:      return "Mode 4: LZ77 + Huffman";
        case CompressionMode::AUTO_BEST:         return "Auto Best Mode";
        default:                                 return "Unknown";
    }
