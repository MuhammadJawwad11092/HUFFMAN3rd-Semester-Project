#### `AdaptiveHuffman.cpp`
```cpp
#include "AdaptiveHuffman.h"
#include <algorithm>
#include <queue>

AdaptiveHuffmanTree::AdaptiveHuffmanTree() {
    reset();
}

void AdaptiveHuffmanTree::reset() {
    poolUsed = 0;
    for (int i = 0; i < 256; i++) {
        leaves[i] = nullptr;
    }
    root = allocNode(SYM_NYT, 0);
    nyt = root;
    rebuildOrderList();
}

AdaptiveHuffmanTree::FGKNode* AdaptiveHuffmanTree::allocNode(int symbol, uint64_t weight) {
    FGKNode* n = &pool[poolUsed];
    n->id = poolUsed + 1;
    n->symbol = symbol;
    n->weight = weight;
    n->order = 0;
    n->parent = nullptr;
    n->left = nullptr;
    n->right = nullptr;
    poolUsed++;
    return n;
}

void AdaptiveHuffmanTree::rebuildOrderList() {
    orderList.clear();
    std::queue<FGKNode*> q;
    q.push(root);
    while (!q.empty()) {
        FGKNode* cur = q.front();
        q.pop();
        orderList.push_back(cur);
        // Right child before left child so order decreases right-to-left, top-to-bottom
        if (cur->right) q.push(cur->right);
        if (cur->left) q.push(cur->left);
    }
    int total = static_cast<int>(orderList.size());
    for (int i = 0; i < total; i++) {
        orderList[i]->order = total - 1 - i;
    }
}

AdaptiveHuffmanTree::FGKNode* AdaptiveHuffmanTree::findBlockLeader(FGKNode* node) const {
    // orderList is sorted by order descending (highest order at index 0)
    for (FGKNode* candidate : orderList) {
        if (candidate == root) continue;
        if (candidate->weight == node->weight) {
            // Never swap a node with its own parent (can happen when sibling is NYT of weight 0)
            if (candidate == node->parent) continue;
            return candidate;
        }
    }
    return node;
}

void AdaptiveHuffmanTree::swapNodes(FGKNode* a, FGKNode* b) {
    if (a == b || !a || !b || a == root || b == root) return;

    FGKNode* pa = a->parent;
    FGKNode* pb = b->parent;

    if (pa == pb) {
        std::swap(pa->left, pa->right);
    } else {
        if (pa->left == a) pa->left = b;
        else pa->left == b ? (pa->left = b) : (pa->right = b);

        if (pb->left == b) pb->left = a;
        else pb->right = a;

        a->parent = pb;
        b->parent = pa;
    }
    rebuildOrderList();
}

std::string AdaptiveHuffmanTree::getCodeToNode(const FGKNode* target) const {
    std::string code;
    const FGKNode* cur = target;
    while (cur != root && cur->parent != nullptr) {
        code.push_back(cur->parent->left == cur ? '0' : '1');
        cur = cur->parent;
    }
    std::reverse(code.begin(), code.end());
    return code;
}

void AdaptiveHuffmanTree::update(uint8_t byteVal, TraceLogger* logger) {
    FGKNode* curr = leaves[byteVal];

    if (curr == nullptr) {
        // Split current NYT into (new NYT on left, new symbol leaf on right)
        FGKNode* oldNyt = nyt;
        FGKNode* newNyt = allocNode(SYM_NYT, 0);
        FGKNode* newLeaf = allocNode(static_cast<int>(byteVal), 1);

        oldNyt->symbol = SYM_INTERNAL;
        oldNyt->weight = 1;
        oldNyt->left = newNyt;
        oldNyt->right = newLeaf;
        newNyt->parent = oldNyt;
        newLeaf->parent = oldNyt;

        leaves[byteVal] = newLeaf;
        nyt = newNyt;

        rebuildOrderList();

        if (logger && logger->enabled) {
            logger->registerTreeNode(newLeaf->id, byteVal, 1, -1, -1, true);
        }

        curr = oldNyt->parent;
    }

    while (curr != nullptr) {
        if (curr != root) {
            FGKNode* leader = findBlockLeader(curr);
            if (leader != curr && leader != curr->parent) {
                if (logger && logger->enabled) {
                    std::vector<HeapSlotSnapshot> snap;
                    for (FGKNode* n : orderList) {
                        snap.push_back({n->id, n->symbol, n->weight});
                    }
                    logger->logHeapSwap("FGK_SiblingSwap", curr->order, leader->order, snap);
                }
                swapNodes(curr, leader);
            }
        }
        curr->weight++;
        curr = curr->parent;
    }
}

void AdaptiveHuffmanTree::encodeByte(uint8_t byteVal, BitWriter& writer, TraceLogger* logger) {
    if (leaves[byteVal] != nullptr) {
        std::string code = getCodeToNode(leaves[byteVal]);
        writer.writeCodeString(code, byteVal);
    } else {
        std::string nytCode = getCodeToNode(nyt);
        if (!nytCode.empty()) {
            writer.writeCodeString(nytCode, SYM_NYT);
        }
        writer.writeBits(byteVal, 8, byteVal, "NYT+RAW");
    }
    update(byteVal, logger);
}

bool AdaptiveHuffmanTree::decodeByte(BitReader& reader, uint8_t& outByte, TraceLogger* logger) {
    FGKNode* curr = root;
    while (curr->left != nullptr || curr->right != nullptr) {
        int bit = 0;
        if (!reader.readBit(bit)) return false;
        FGKNode* next = (bit == 0) ? curr->left : curr->right;
        if (!next) return false;
        if (logger && logger->enabled) {
            bool isLeaf = (next->left == nullptr && next->right == nullptr);
            logger->logDecodeStep(bit, curr->id, next->id, isLeaf, next->symbol);
        }
        curr = next;
    }

    if (curr->symbol == SYM_NYT) {
        uint32_t raw = 0;
        if (!reader.readBits(8, raw)) return false;
        outByte = static_cast<uint8_t>(raw & 0xFF);
    } else {
        outByte = static_cast<uint8_t>(curr->symbol & 0xFF);
    }

    update(outByte, logger);
    return true;
}
