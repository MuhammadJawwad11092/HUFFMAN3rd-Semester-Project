void LZ77Engine::tokenizeBlock(const uint8_t* data, size_t len, std::vector<LZ77Token>& outTokens) {
    outTokens.clear();
    if (len == 0) return;

    std::vector<int> head(HASH_SIZE, -1);
    std::vector<int> prev(len, -1);

    size_t pos = 0;
    while (pos < len) {
        int bestLen = 0;
        int bestDist = 0;

        if (pos + MIN_MATCH <= len) {
            uint32_t h = hash3(data + pos);
            int matchPos = head[h];
            int chain = 0;

            while (matchPos >= 0 && chain < MAX_CHAIN) {
                size_t dist = pos - static_cast<size_t>(matchPos);
                if (dist > WINDOW_SIZE) break;

                // Quick boundary check before full loop
                if (bestLen < MAX_MATCH &&
                    (pos + bestLen < len) &&
                    data[matchPos + bestLen] == data[pos + bestLen]) {
                    size_t maxAvail = std::min(static_cast<size_t>(MAX_MATCH), len - pos);
                    size_t mlen = 0;
                    while (mlen < maxAvail && data[matchPos + mlen] == data[pos + mlen]) {
                        mlen++;
                    }
                    if (static_cast<int>(mlen) >= MIN_MATCH && static_cast<int>(mlen) > bestLen) {
                        bestLen = static_cast<int>(mlen);
                        bestDist = static_cast<int>(dist);
                        if (bestLen == MAX_MATCH) break;
                    }
                }
                matchPos = prev[matchPos];
                chain++;
            }

            if (bestLen >= MIN_MATCH) {
                outTokens.push_back({true, static_cast<uint16_t>(bestLen), static_cast<uint16_t>(bestDist)});
                // Insert skipped positions into hash chain for stronger future matches
                size_t endPos = std::min(pos + static_cast<size_t>(bestLen), len);
                for (size_t k = pos; k < endPos; k++) {
                    if (k + MIN_MATCH <= len) {
                        uint32_t hk = hash3(data + k);
                        prev[k] = head[hk];
                        head[hk] = static_cast<int>(k);
                    }
                }
                pos += static_cast<size_t>(bestLen);
                continue;
            }

            prev[pos] = head[h];
            head[h] = static_cast<int>(pos);
        }

        outTokens.push_back({false, static_cast<uint16_t>(data[pos]), 0});
        pos++;
    }
}

void LZ77Engine::encodeBlock(const std::vector<LZ77Token>& tokens, BitWriter& writer, TraceLogger* logger) {
    uint64_t litLenFreq[LITLEN_SYMBOLS] = {0};
    uint64_t distFreq[DIST_SYMBOLS] = {0};

    for (const auto& tok : tokens) {
        if (!tok.isMatch) {
            litLenFreq[tok.litOrLen]++;
        } else {
            int lCode = getLengthCode(tok.litOrLen);
            int dCode = getDistCode(tok.dist);
            litLenFreq[lCode]++;
            distFreq[dCode]++;
        }
    }
    litLenFreq[256] = 1; // End-Of-Block marker

    uint8_t litLens[LITLEN_SYMBOLS] = {0};
    uint32_t litCodes[LITLEN_SYMBOLS] = {0};
    Node* litTree = buildHuffmanTree(litLenFreq, LITLEN_SYMBOLS, logger);
    computeTreeBitLengths(litTree, litLens);
    deleteHuffmanTree(litTree);
    limitBitLengths(litLens, LITLEN_SYMBOLS, 24);
    assignCanonicalCodes(litLens, LITLEN_SYMBOLS, litCodes);

    if (logger && logger->enabled) {
        for (int s = 0; s < LITLEN_SYMBOLS; s++) {
            if (litLens[s] > 0) {
                logger->registerCode(s, litLenFreq[s], canonicalCodeToString(litCodes[s], litLens[s]));
            }
        }
    }

    uint8_t distLens[DIST_SYMBOLS] = {0};
    uint32_t distCodes[DIST_SYMBOLS] = {0};
    bool hasDist = false;
    for (int i = 0; i < DIST_SYMBOLS; i++) {
        if (distFreq[i] > 0) { hasDist = true; break; }
    }
    if (hasDist) {
        Node* distTree = buildHuffmanTree(distFreq, DIST_SYMBOLS, nullptr);
        computeTreeBitLengths(distTree, distLens);
        deleteHuffmanTree(distTree);
        limitBitLengths(distLens, DIST_SYMBOLS, 24);
        assignCanonicalCodes(distLens, DIST_SYMBOLS, distCodes);
    }

    writer.setSection("tree");
    writeCanonicalHeader(writer, litLens, LITLEN_SYMBOLS);
    writer.writeByteRaw(hasDist ? 1 : 0);
    if (hasDist) {
        writeCanonicalHeader(writer, distLens, DIST_SYMBOLS);
    }

    writer.setSection("payload");
    for (const auto& tok : tokens) {
        if (!tok.isMatch) {
            int sym = tok.litOrLen;
            writer.writeBits(litCodes[sym], litLens[sym], sym, canonicalCodeToString(litCodes[sym], litLens[sym]));
        } else {
            int lCode = getLengthCode(tok.litOrLen);
            int lIdx = lCode - 257;
            writer.writeBits(litCodes[lCode], litLens[lCode], lCode, canonicalCodeToString(litCodes[lCode], litLens[lCode]));
            if (LEN_EXTRA[lIdx] > 0) {
                writer.writeBits(static_cast<uint32_t>(tok.litOrLen - LEN_BASE[lIdx]), LEN_EXTRA[lIdx]);
            }

            int dCode = getDistCode(tok.dist);
            writer.writeBits(distCodes[dCode], distLens[dCode]);
            if (DIST_EXTRA[dCode] > 0) {
                writer.writeBits(static_cast<uint32_t>(tok.dist - DIST_BASE[dCode]), DIST_EXTRA[dCode]);
            }
        }
    }

    // Write EOB marker (symbol 256)
    writer.writeBits(litCodes[256], litLens[256], 256, canonicalCodeToString(litCodes[256], litLens[256]));
}

bool LZ77Engine::decodeBlock(BitReader& reader, std::vector<uint8_t>& outBlock, TraceLogger* logger) {
    uint8_t litLens[LITLEN_SYMBOLS] = {0};
    uint32_t litCodes[LITLEN_SYMBOLS] = {0};
    if (!readCanonicalHeader(reader, litLens, LITLEN_SYMBOLS)) return false;
    assignCanonicalCodes(litLens, LITLEN_SYMBOLS, litCodes);
    Node* litTree = buildCanonicalDecodeTree(litLens, litCodes, LITLEN_SYMBOLS, logger);

    uint8_t hasDist = 0;
    if (!reader.readByteRaw(hasDist)) {
        deleteHuffmanTree(litTree);
        return false;
    }

    Node* distTree = nullptr;
    if (hasDist) {
        uint8_t distLens[DIST_SYMBOLS] = {0};
        uint32_t distCodes[DIST_SYMBOLS] = {0};
        if (!readCanonicalHeader(reader, distLens, DIST_SYMBOLS)) {
            deleteHuffmanTree(litTree);
            return false;
        }
        assignCanonicalCodes(distLens, DIST_SYMBOLS, distCodes);
        distTree = buildCanonicalDecodeTree(distLens, distCodes, DIST_SYMBOLS, nullptr);
    }

    while (true) {
        int sym = decodeSymbolFromTree(reader, litTree, logger);
        if (sym < 0) {
            deleteHuffmanTree(litTree);
            deleteHuffmanTree(distTree);
            return false;
        }
        if (sym == 256) {
            break; // End-Of-Block
        }
        if (sym < 256) {
            outBlock.push_back(static_cast<uint8_t>(sym));
        } else {
            int lIdx = sym - 257;
            if (lIdx < 0 || lIdx >= 29) {
                deleteHuffmanTree(litTree);
                deleteHuffmanTree(distTree);
                return false;
            }
            uint32_t extraLen = 0;
            if (LEN_EXTRA[lIdx] > 0 && !reader.readBits(LEN_EXTRA[lIdx], extraLen)) {
                deleteHuffmanTree(litTree);
                deleteHuffmanTree(distTree);
                return false;
            }
            int matchLen = LEN_BASE[lIdx] + static_cast<int>(extraLen);

            if (!distTree) {
                deleteHuffmanTree(litTree);
                return false;
            }
            int dCode = decodeSymbolFromTree(reader, distTree, nullptr);
            if (dCode < 0 || dCode >= DIST_SYMBOLS) {
                deleteHuffmanTree(litTree);
                deleteHuffmanTree(distTree);
                return false;
            }
            uint32_t extraDist = 0;
            if (DIST_EXTRA[dCode] > 0 && !reader.readBits(DIST_EXTRA[dCode], extraDist)) {
                deleteHuffmanTree(litTree);
                deleteHuffmanTree(distTree);
                return false;
            }
            int matchDist = DIST_BASE[dCode] + static_cast<int>(extraDist);
            if (matchDist <= 0 || static_cast<size_t>(matchDist) > outBlock.size()) {
                deleteHuffmanTree(litTree);
                deleteHuffmanTree(distTree);
                return false;
            }

            // Byte-by-byte copy preserves overlapping RLE matches (when dist < matchLen)
            for (int i = 0; i < matchLen; i++) {
                outBlock.push_back(outBlock[outBlock.size() - static_cast<size_t>(matchDist)]);
            }
        }
    }

    deleteHuffmanTree(litTree);
    deleteHuffmanTree(distTree);
    return true;
}
