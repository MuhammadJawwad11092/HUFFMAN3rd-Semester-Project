int TraceLogger::nextNodeId() {
    return nextIdCounter++;
}

void TraceLogger::registerTreeNode(int id, int symbol, uint64_t freq, int leftId, int rightId, bool isLeaf) {
    if (!enabled) return;
    treeNodes.push_back({id, symbol, freq, leftId, rightId, isLeaf});
}

void TraceLogger::registerCode(int symbol, uint64_t freq, const std::string& code) {
    if (!enabled) return;
    codes.push_back({symbol, freq, code});
}

void TraceLogger::recordHexByte(uint8_t byteVal, const std::string& section) {
    if (!enabled) return;
    if (hexBytes.size() < 16384) {
        hexBytes.push_back({byteVal, section});
    }
}

void TraceLogger::logHeapInit(const std::vector<HeapSlotSnapshot>& snapshot) {
    if (!enabled || events.size() >= maxEvents) return;
    TraceEvent ev;
    ev.type = "HEAP_INIT";
    ev.detail = "Initialized MinHeap with " + std::to_string(snapshot.size()) + " active symbol nodes";
    ev.heapSnapshot = snapshot;
    events.push_back(std::move(ev));
}

void TraceLogger::logHeapSwap(const std::string& direction, int idxA, int idxB, const std::vector<HeapSlotSnapshot>& snapshot) {
    if (!enabled || events.size() >= maxEvents) return;
    TraceEvent ev;
    ev.type = "HEAP_SWAP";
    ev.detail = direction + ": swapped MinHeap[" + std::to_string(idxA) + "] <-> MinHeap[" + std::to_string(idxB) + "]";
    ev.idxA = idxA;
    ev.idxB = idxB;
    ev.heapSnapshot = snapshot;
    events.push_back(std::move(ev));
}

void TraceLogger::logExtractMerge(int leftId, int rightId, int parentId, uint64_t parentFreq, const std::vector<HeapSlotSnapshot>& snapshot) {
    if (!enabled || events.size() >= maxEvents) return;
    TraceEvent ev;
    ev.type = "EXTRACT_MERGE";
    ev.detail = "Extracted min pair (#" + std::to_string(leftId) + ", #" + std::to_string(rightId) +
                ") -> merged parent #" + std::to_string(parentId) + " (freq=" + std::to_string(parentFreq) + ")";
    ev.leftId = leftId;
    ev.rightId = rightId;
    ev.parentId = parentId;
    ev.freq = parentFreq;
    ev.heapSnapshot = snapshot;
    events.push_back(std::move(ev));
}

void TraceLogger::logBitPush(int bit, uint8_t bitBuffer, int bitCount, int symbol, const std::string& code) {
    if (!enabled || events.size() >= maxEvents) return;
    TraceEvent ev;
    ev.type = "BIT_PUSH";
    ev.bit = bit;
    ev.bitBuffer = bitBuffer;
    ev.bitCount = bitCount;
    ev.symbol = symbol;
    ev.code = code;
    ev.detail = "bit_buffer = (bit_buffer << 1) | " + std::to_string(bit) +
                "  [" + std::to_string(bitCount) + "/8 bits]";
    events.push_back(std::move(ev));
}

void TraceLogger::logBitFlush(uint8_t byteVal, const std::string& section) {
    if (!enabled || events.size() >= maxEvents) return;
    char hexBuf[8];
    std::snprintf(hexBuf, sizeof(hexBuf), "0x%02X", byteVal);
    TraceEvent ev;
    ev.type = "BIT_FLUSH";
    ev.byteVal = byteVal;
    ev.section = section;
    ev.detail = "Flushed 8-bit register -> " + std::string(hexBuf) + " (" + section + ")";
    events.push_back(std::move(ev));
}

void TraceLogger::logDecodeStep(int bit, int fromId, int toId, bool isLeaf, int decodedSym) {
    if (!enabled || events.size() >= maxEvents) return;
    TraceEvent ev;
    ev.type = "DECODE_STEP";
    ev.bit = bit;
    ev.fromId = fromId;
    ev.toId = toId;
    ev.isLeaf = isLeaf;
    ev.symbol = decodedSym;
    ev.detail = "Decode bit " + std::to_string(bit) + (bit == 0 ? " (left)" : " (right)") +
                " #" + std::to_string(fromId) + " -> #" + std::to_string(toId) +
                (isLeaf ? (" [LEAF " + formatSymbolLabel(decodedSym) + "]") : "");
    events.push_back(std::move(ev));
}

std::string TraceLogger::escapeJson(const std::string& s) {
    std::ostringstream out;
    for (unsigned char c : s) {
        switch (c) {
            case '"':  out << "\\\""; break;
            case '\\': out << "\\\\"; break;
            case '\b': out << "\\b"; break;
            case '\f': out << "\\f"; break;
            case '\n': out << "\\n"; break;
            case '\r': out << "\\r"; break;
            case '\t': out << "\\t"; break;
            default:
                if (c < 0x20 || c >= 0x7F) {
                    char buf[8];
                    std::snprintf(buf, sizeof(buf), "\\u%04x", c);
                    out << buf;
                } else {
                    out << static_cast<char>(c);
                }
        }
    }
    return out.str();
}

std::string TraceLogger::formatSymbolLabel(int sym) {
    if (sym < 0) return "INT";
    if (sym == 256) return "EOB";
    if (sym > 256) return "LEN(" + std::to_string(sym) + ")";
    if (sym == '\n') return "\\n";
    if (sym == '\r') return "\\r";
    if (sym == '\t') return "\\t";
    if (sym == ' ') return "SPACE";
    if (sym >= 32 && sym <= 126) {
        return std::string("'") + static_cast<char>(sym) + "'";
    }
    char buf[8];
    std::snprintf(buf, sizeof(buf), "0x%02X", sym & 0xFF);
    return std::string(buf);
}

std::string TraceLogger::toJson() const {
    std::ostringstream os;
    os << "{";

    // treeNodes
    os << "\"treeNodes\":[";
    for (size_t i = 0; i < treeNodes.size(); i++) {
        const auto& n = treeNodes[i];
        if (i > 0) os << ",";
        os << "{\"id\":" << n.id
           << ",\"symbol\":" << n.symbol
           << ",\"label\":\"" << escapeJson(formatSymbolLabel(n.symbol)) << "\""
           << ",\"freq\":" << n.freq
           << ",\"leftId\":" << n.leftId
           << ",\"rightId\":" << n.rightId
           << ",\"isLeaf\":" << (n.isLeaf ? "true" : "false") << "}";
    }
    os << "],";

    // codes
    os << "\"codes\":[";
    for (size_t i = 0; i < codes.size(); i++) {
        const auto& c = codes[i];
        if (i > 0) os << ",";
        os << "{\"symbol\":" << c.symbol
           << ",\"label\":\"" << escapeJson(formatSymbolLabel(c.symbol)) << "\""
           << ",\"freq\":" << c.freq
           << ",\"code\":\"" << escapeJson(c.code) << "\"}";
    }
    os << "],";

    // hexBytes
    os << "\"hexBytes\":[";
    for (size_t i = 0; i < hexBytes.size(); i++) {
        const auto& h = hexBytes[i];
        if (i > 0) os << ",";
        os << "{\"v\":" << static_cast<int>(h.value)
           << ",\"s\":\"" << escapeJson(h.section) << "\"}";
    }
    os << "],";

    // events
    os << "\"events\":[";
    for (size_t i = 0; i < events.size(); i++) {
        const auto& ev = events[i];
        if (i > 0) os << ",";
        os << "{\"type\":\"" << ev.type << "\""
           << ",\"detail\":\"" << escapeJson(ev.detail) << "\""
           << ",\"idxA\":" << ev.idxA
           << ",\"idxB\":" << ev.idxB
           << ",\"leftId\":" << ev.leftId
           << ",\"rightId\":" << ev.rightId
           << ",\"parentId\":" << ev.parentId
           << ",\"freq\":" << ev.freq
           << ",\"symbol\":" << ev.symbol
           << ",\"label\":\"" << escapeJson(formatSymbolLabel(ev.symbol)) << "\""
           << ",\"bit\":" << ev.bit
           << ",\"bitBuffer\":" << static_cast<int>(ev.bitBuffer)
           << ",\"bitCount\":" << ev.bitCount
           << ",\"byteVal\":" << static_cast<int>(ev.byteVal)
           << ",\"section\":\"" << escapeJson(ev.section) << "\""
           << ",\"code\":\"" << escapeJson(ev.code) << "\""
           << ",\"fromId\":" << ev.fromId
           << ",\"toId\":" << ev.toId
           << ",\"isLeaf\":" << (ev.isLeaf ? "true" : "false")
           << ",\"heap\":[";
        for (size_t j = 0; j < ev.heapSnapshot.size(); j++) {
            const auto& hs = ev.heapSnapshot[j];
            if (j > 0) os << ",";
            os << "{\"id\":" << hs.id
               << ",\"sym\":" << hs.symbol
               << ",\"lbl\":\"" << escapeJson(formatSymbolLabel(hs.symbol)) << "\""
               << ",\"freq\":" << hs.freq << "}";
        }
        os << "]}";
    }
    os << "]}";
    return os.str();
}
