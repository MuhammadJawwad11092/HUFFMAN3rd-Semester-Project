                     "2026-11-25T14:%02d:%02d.%03dZ [%s] svc=edge-proxy ip=10.24.18.%d method=POST path=%s status=%d latency_ms=%d msg=\"%s\"\n",
                     (seq / 60) % 60, seq % 60, (seq * 37) % 1000,
                     levels[seq % 4], 10 + (seq % 12), paths[seq % 4],
                     (seq % 4 == 2) ? 502 : 200, 12 + (seq % 85), msgs[seq % 4]);
            out += line;
            seq++;
        }
    } else if (preset == "dna") {
        const char* motifs[] = {
            "ATCGATCGATCGTAGCTAGCTAGCTA",
            "GGGGAAAACCCCTTTTATCGATCGAT",
            "ATATATATATGCGCGCGCGTAGCTAG",
            "CGTACGTACGTAGCTAGCTAGAAAAA"
        };
        int seq = 1;
        while (out.size() < targetBytes) {
            char header[64];
            snprintf(header, sizeof(header), ">CHR_%03d_HOMO_SAPIENS_SEGMENT\n", seq++);
            out += header;
            for (int i = 0; i < 6 && out.size() < targetBytes; i++) {
                out += motifs[(seq + i) % 4];
                out += motifs[(seq + i + 1) % 4];
                out += '\n';
            }
        }
    } else if (preset == "json") {
        int seq = 0;
        out += "[\n";
        while (out.size() + 180 < targetBytes) {
            char obj[256];
            snprintf(obj, sizeof(obj),
                     "  {\"device_id\":\"sensor-rack-%02d\",\"ts\":179561%04d,\"temp_c\":%.2f,\"humidity\":%.1f,\"voltage\":3.31,\"status\":\"OK\"}%s\n",
                     (seq % 8) + 1, seq % 10000, 22.40 + (seq % 5) * 0.15, 48.0 + (seq % 7) * 0.5,
                     (out.size() + 360 < targetBytes) ? "," : "");
            out += obj;
            seq++;
        }
        out += "]\n";
    } else {
        // English Corpus
        const char* paragraphs[] = {
            "Data compression reduces the number of bits required to represent information while preserving exact fidelity. ",
            "Huffman coding assigns variable-length prefix-free binary codes based on symbol frequency statistics. ",
            "Canonical Huffman coding eliminates full tree serialization by transmitting only symbol bit lengths. ",
            "Combining LZ77 sliding-window dictionary matching with Huffman entropy coding captures both long-range phrase repetition and byte skew.\n"
        };
        int idx = 0;
        while (out.size() < targetBytes) {
            out += paragraphs[idx % 4];
            idx++;
        }
    }

    if (out.size() > targetBytes) {
        out.resize(targetBytes);
    }
    return vector<uint8_t>(out.begin(), out.end());
}

vector<BenchmarkRow> BenchmarkSuite::runAllModes(const vector<uint8_t>& data) {
    CompressionMode modes[] = {
        CompressionMode::RAW_BYPASS,
        CompressionMode::STATIC_HUFFMAN,
        CompressionMode::CANONICAL_HUFFMAN,
        CompressionMode::ADAPTIVE_FGK,
        CompressionMode::LZ77_HUFFMAN
    };

    vector<BenchmarkRow> rows;
    for (CompressionMode m : modes) {
        vector<uint8_t> compressed;
        CompressionResult cres = compressBuffer(data, compressed, m, false, nullptr);

        vector<uint8_t> restored;
        DecompressionResult dres = decompressBuffer(compressed, restored, nullptr);

        BenchmarkRow row;
        row.modeId = static_cast<int>(m);
        row.modeName = modeToString(m);
        row.originalSize = data.size();
        row.compressedSize = compressed.size();
        row.headerOverhead = cres.headerBytes + cres.treeHeaderBytes;
        row.ratioPercent = (data.empty()) ? 100.0 : (100.0 * static_cast<double>(compressed.size()) / static_cast<double>(data.size()));
        row.savingsPercent = 100.0 - row.ratioPercent;
        row.compressMs = cres.durationMs;
        row.decompressMs = dres.durationMs;
        row.crc32 = cres.crc32;
        row.crcVerified = dres.crcVerified;
        row.roundtripMatch = (restored == data);
        row.bypassRecommended = (m != CompressionMode::RAW_BYPASS && compressed.size() >= data.size() + 17);
        rows.push_back(row);
    }
    return rows;
}

string BenchmarkSuite::resultsToJson(const string& datasetName, const vector<BenchmarkRow>& rows) {
    ostringstream os;
    os << "{\"dataset\":\"" << TraceLogger::escapeJson(datasetName) << "\",\"rows\":[";
    for (size_t i = 0; i < rows.size(); i++) {
        const auto& r = rows[i];
        if (i > 0) os << ",";
        char crcHex[16];
        snprintf(crcHex, sizeof(crcHex), "0x%08X", r.crc32);
        os << "{\"modeId\":" << r.modeId
           << ",\"modeName\":\"" << TraceLogger::escapeJson(r.modeName) << "\""
           << ",\"originalSize\":" << r.originalSize
           << ",\"compressedSize\":" << r.compressedSize
           << ",\"headerOverhead\":" << r.headerOverhead
           << ",\"ratioPercent\":" << r.ratioPercent
           << ",\"savingsPercent\":" << r.savingsPercent
           << ",\"compressMs\":" << r.compressMs
           << ",\"decompressMs\":" << r.decompressMs
           << ",\"crc32\":\"" << crcHex << "\""
           << ",\"crcVerified\":" << (r.crcVerified ? "true" : "false")
           << ",\"roundtripMatch\":" << (r.roundtripMatch ? "true" : "false")
           << ",\"bypassRecommended\":" << (r.bypassRecommended ? "true" : "false") << "}";
    }
    os << "]}";
    return os.str();
}
