Node* deserializeTree(ifstream& in_file) {
    int marker = in_file.get();
    if (marker == EOF) return nullptr;
    if (marker == 1) {
        int ch = in_file.get();
        if (ch == EOF) return nullptr;
        return new Node(static_cast<unsigned char>(ch), 0);
    } else if (marker == 0) {
        Node* internal = new Node('\0', 0);
        internal->left = deserializeTree(in_file);
        internal->right = deserializeTree(in_file);
        if (!internal->left || !internal->right) {
            deleteTree(internal);
            return nullptr;
        }
        return internal;
    }
    return nullptr;
}

namespace {
    constexpr size_t IO_CHUNK_SIZE = 65536;

    class ChunkedOutputSink {
        ostream& out;
        vector<uint8_t> buf;
        uint32_t crc;
        uint64_t written;

    public:
        explicit ChunkedOutputSink(ostream& o)
            : out(o), crc(crc32_init()), written(0) {
            buf.reserve(IO_CHUNK_SIZE);
        }

        void pushByte(uint8_t b) {
            buf.push_back(b);
            written++;
            if (buf.size() == IO_CHUNK_SIZE) {
                flush();
            }
        }

        void pushBytes(const uint8_t* data, size_t len) {
            crc = crc32_update(crc, data, len);
            out.write(reinterpret_cast<const char*>(data), static_cast<streamsize>(len));
            written += len;
        }

        void flush() {
            if (!buf.empty()) {
                crc = crc32_update(crc, buf.data(), buf.size());
                out.write(reinterpret_cast<const char*>(buf.data()), static_cast<streamsize>(buf.size()));
                buf.clear();
            }
        }

        uint32_t finalizeCrc() {
            flush();
            return crc32_finalize(crc);
        }

        uint64_t totalWritten() const { return written; }
    };

    DecompressionResult decompressStreamCore(istream& in, ostream& out, TraceLogger* logger) {
        DecompressionResult res;
        auto tStart = chrono::steady_clock::now();

        BitReader reader(in);

        uint8_t magic[4] = {0};
        if (!reader.readBytesRaw(magic, 4)) {
            res.errorMessage = "Empty or truncated file (missing HUF2 magic header).";
            return res;
        }

        if (magic[0] != 'H' || magic[1] != 'U' || magic[2] != 'F' || magic[3] != '2') {
            res.errorMessage = "Invalid magic signature (expected HUF2).";
            return res;
        }

        uint8_t modeByte = 0;
        uint64_t originalSize = 0;
        uint32_t expectedCrc = 0;
        if (!reader.readByteRaw(modeByte) ||
            !reader.readUint64LE(originalSize) ||
            !reader.readUint32LE(expectedCrc)) {
            res.errorMessage = "Truncated HUF2 header metadata.";
            return res;
        }

        res.modeDetected = static_cast<CompressionMode>(modeByte);
        res.originalSize = originalSize;
        res.expectedCrc32 = expectedCrc;

        ChunkedOutputSink sink(out);

        if (originalSize == 0) {
            res.computedCrc32 = sink.finalizeCrc();
            res.crcVerified = (res.computedCrc32 == expectedCrc);
            res.success = res.crcVerified;
            if (!res.crcVerified) res.errorMessage = "CRC32 mismatch on empty file.";
            auto tEnd = chrono::steady_clock::now();
            res.durationMs = chrono::duration<double, milli>(tEnd - tStart).count();
            return res;
        }

        if (res.modeDetected == CompressionMode::RAW_BYPASS) {
            vector<uint8_t> chunk(IO_CHUNK_SIZE);
            uint64_t remaining = originalSize;
            while (remaining > 0) {
                size_t toRead = static_cast<size_t>(min<uint64_t>(remaining, IO_CHUNK_SIZE));
                if (!reader.readBytesRaw(chunk.data(), toRead)) {
                    res.errorMessage = "Unexpected EOF in Raw Bypass payload.";
                    return res;
                }
                sink.pushBytes(chunk.data(), toRead);
                remaining -= toRead;
            }
        } else if (res.modeDetected == CompressionMode::STATIC_HUFFMAN ||
                   res.modeDetected == CompressionMode::CANONICAL_HUFFMAN) {
            Node* root = nullptr;
            if (res.modeDetected == CompressionMode::STATIC_HUFFMAN) {
                root = deserializeHuffmanTree(reader, logger);
            } else {
                uint8_t lengths[256] = {0};
                uint32_t codes[256] = {0};
                if (!readCanonicalHeader(reader, lengths, 256)) {
                    res.errorMessage = "Failed to read Canonical Huffman header.";
                    return res;
                }
                assignCanonicalCodes(lengths, 256, codes);
                root = buildCanonicalDecodeTree(lengths, codes, 256, logger);
            }

            if (!root) {
                res.errorMessage = "Failed to reconstruct Huffman decode tree.";
                return res;
            }

            // Single unique character optimization
            if (root->isLeaf()) {
                vector<uint8_t> fillChunk(min<uint64_t>(originalSize, IO_CHUNK_SIZE), root->character);
                uint64_t remaining = originalSize;
                while (remaining > 0) {
                    size_t n = static_cast<size_t>(min<uint64_t>(remaining, fillChunk.size()));
                    sink.pushBytes(fillChunk.data(), n);
                    remaining -= n;
                }
            } else {
                uint64_t decoded = 0;
                Node* curr = root;
                while (decoded < originalSize) {
                    int bit = 0;
                    if (!reader.readBit(bit)) {
                        deleteHuffmanTree(root);
                        res.errorMessage = "Unexpected EOF in Huffman bitstream.";
                        return res;
                    }
                    Node* next = (bit == 0) ? curr->left : curr->right;
                    if (!next) {
                        deleteHuffmanTree(root);
                        res.errorMessage = "Corrupted Huffman bitstream (null child).";
                        return res;
                    }
                    if (logger && logger->enabled) {
                        logger->logDecodeStep(bit, curr->id, next->id, next->isLeaf(), next->symbol);
                    }
                    curr = next;
                    if (curr->isLeaf()) {
                        sink.pushByte(curr->character);
                        decoded++;
                        curr = root;
                    }
                }
            }
            deleteHuffmanTree(root);
        } else if (res.modeDetected == CompressionMode::ADAPTIVE_FGK) {
            AdaptiveHuffmanTree fgk;
            uint64_t decoded = 0;
            while (decoded < originalSize) {
                uint8_t b = 0;
                if (!fgk.decodeByte(reader, b, logger)) {
                    res.errorMessage = "Unexpected EOF or corrupted Adaptive FGK stream.";
                    return res;
                }
                sink.pushByte(b);
                decoded++;
            }
        } else if (res.modeDetected == CompressionMode::LZ77_HUFFMAN) {
            uint64_t decoded = 0;
            vector<uint8_t> block;
            while (decoded < originalSize) {
                block.clear();
                if (!LZ77Engine::decodeBlock(reader, block, logger)) {
                    res.errorMessage = "Corrupted LZ77 + Huffman block.";
                    return res;
                }
                if (!block.empty()) {
                    sink.pushBytes(block.data(), block.size());
                    decoded += block.size();
                } else {
                    break;
                }
            }
        } else {
            res.errorMessage = "Unsupported compression mode in HUF2 header.";
            return res;
        }

        res.computedCrc32 = sink.finalizeCrc();
        res.crcVerified = (res.computedCrc32 == expectedCrc);

        if (sink.totalWritten() != originalSize) {
            res.errorMessage = "Size mismatch: decoded " + to_string(sink.totalWritten()) +
                               " bytes vs expected " + to_string(originalSize) + " bytes.";
            return res;
        }
        if (!res.crcVerified) {
            res.errorMessage = "CRC32 integrity check FAILED!";
            return res;
        }

        res.success = true;
        auto tEnd = chrono::steady_clock::now();
        res.durationMs = chrono::duration<double, milli>(tEnd - tStart).count();
        return res;
    }
}

bool decompressFile(const string& input_file_path, const string& output_file_path) {
    DecompressionResult r = decompressFileEx(input_file_path, output_file_path, nullptr);
    if (!r.success && !r.errorMessage.empty()) {
        cerr << "Error: " << r.errorMessage << endl;
    }
    return r.success;
}

DecompressionResult decompressFileEx(const string& inputPath,
                                     const string& outputPath,
                                     TraceLogger* logger) {
    DecompressionResult fail;
    ifstream inFile(inputPath, ios::binary);
    if (!inFile.is_open()) {
        fail.errorMessage = "Could not open compressed file: " + inputPath;
        return fail;
    }

    ofstream outFile(outputPath, ios::binary);
    if (!outFile.is_open()) {
        fail.errorMessage = "Could not open output file: " + outputPath;
        return fail;
    }

    DecompressionResult res = decompressStreamCore(inFile, outFile, logger);
    inFile.close();
    outFile.close();
    return res;
}

DecompressionResult decompressBuffer(const vector<uint8_t>& inputData,
                                     vector<uint8_t>& outputData,
                                     TraceLogger* logger) {
    string inStr(reinterpret_cast<const char*>(inputData.data()), inputData.size());
    istringstream inStream(inStr, ios::binary);
    ostringstream outStream(ios::binary);

    DecompressionResult res = decompressStreamCore(inStream, outStream, logger);
    string s = outStream.str();
    outputData.assign(s.begin(), s.end());
    return res;
}
