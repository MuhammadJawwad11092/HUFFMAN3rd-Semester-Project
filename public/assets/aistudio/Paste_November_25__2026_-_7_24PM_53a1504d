#include "CRC32.h"

namespace {
    struct CRC32Table {
        uint32_t entries[256];
        CRC32Table() {
            for (uint32_t i = 0; i < 256; i++) {
                uint32_t c = i;
                for (int k = 0; k < 8; k++) {
                    if (c & 1)
                        c = 0xEDB88320u ^ (c >> 1);
                    else
                        c >>= 1;
                }
                entries[i] = c;
            }
        }
    };

    const CRC32Table& getTable() {
        static CRC32Table table;
        return table;
    }
}

uint32_t crc32_init() {
