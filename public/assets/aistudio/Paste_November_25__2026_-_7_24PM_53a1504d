```cpp
#include "MinHeap.h"

MinHeap::MinHeap(TraceLogger* traceLogger)
    : size(0), logger(traceLogger) {
    for (int i = 0; i < MAX_CAPACITY; i++) {
        heap[i] = nullptr;
    }
}

int MinHeap::getSize() const {
    return size;
}

std::vector<HeapSlotSnapshot> MinHeap::getSnapshot() const {
    std::vector<HeapSlotSnapshot> snap;
    snap.reserve(size);
    for (int i = 0; i < size; i++) {
        snap.push_back({heap[i]->id, heap[i]->symbol, heap[i]->freq});
    }
    return snap;
}

void MinHeap::insert(Node* newNode) {
    if (size >= MAX_CAPACITY) return;
    heap[size] = newNode;
    size++;
    heapifyUp(size - 1);
}

Node* MinHeap::extractMin() {
    if (size == 0) return nullptr;

    Node* minNode = heap[0];
    heap[0] = heap[size - 1];
    size--;

    if (size > 0) {
        heapifyDown(0);
    }
    return minNode;
}

void MinHeap::heapifyUp(int index) {
    while (index > 0) {
        int parentIndex = (index - 1) / 2;

        if (heap[index]->freq < heap[parentIndex]->freq) {
            Node* temp = heap[index];
            heap[index] = heap[parentIndex];
            heap[parentIndex] = temp;

            if (logger && logger->enabled) {
                logger->logHeapSwap("heapifyUp", index, parentIndex, getSnapshot());
            }
            index = parentIndex;
        } else {
            break;
        }
    }
}

void MinHeap::heapifyDown(int index) {
    while (true) {
        int leftChild = 2 * index + 1;
        int rightChild = 2 * index + 2;
        int smallest = index;

        if (leftChild < size && heap[leftChild]->freq < heap[smallest]->freq) {
            smallest = leftChild;
        }
        if (rightChild < size && heap[rightChild]->freq < heap[smallest]->freq) {
            smallest = rightChild;
        }

        if (smallest == index) break;

        Node* temp = heap[index];
        heap[index] = heap[smallest];
        heap[smallest] = temp;

        if (logger && logger->enabled) {
            logger->logHeapSwap("heapifyDown", index, smallest, getSnapshot());
        }
        index = smallest;
    }
}
