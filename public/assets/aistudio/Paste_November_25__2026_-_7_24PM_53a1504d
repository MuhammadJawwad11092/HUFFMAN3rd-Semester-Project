    string extractJsonString(const string& json, const string& key, const string& fallback = "") {
        string pattern = "\"" + key + "\"";
        size_t pos = json.find(pattern);
        if (pos == string::npos) return fallback;
        pos = json.find(':', pos + pattern.size());
        if (pos == string::npos) return fallback;
        pos++;
        while (pos < json.size() && isspace(static_cast<unsigned char>(json[pos]))) pos++;
        if (pos >= json.size() || json[pos] != '"') return fallback;
        pos++;
        string out;
        while (pos < json.size() && json[pos] != '"') {
            if (json[pos] == '\\' && pos + 1 < json.size()) {
                char esc = json[++pos];
                switch (esc) {
                    case '"':  out.push_back('"'); break;
                    case '\\': out.push_back('\\'); break;
                    case 'n':  out.push_back('\n'); break;
                    case 'r':  out.push_back('\r'); break;
                    case 't':  out.push_back('\t'); break;
                    default:   out.push_back(esc); break;
