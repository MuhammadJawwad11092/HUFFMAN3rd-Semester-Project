        for (int i = 28; i >= 0; i--) {
            if (length >= LEN_BASE[i]) return 257 + i;
        }
        return 257;
    }

    int getDistCode(int dist) {
        for (int i = 29; i >= 0; i--) {
            if (dist >= DIST_BASE[i]) return i;
        }
        return 0;
    }

    inline uint32_t hash3(const uint8_t* p) {
        return ((static_cast<uint32_t>(p[0]) << 10) ^
                (static_cast<uint32_t>(p[1]) << 5) ^
                static_cast<uint32_t>(p[2])) & (LZ77Engine::HASH_SIZE - 1);
    }

    int decodeSymbolFromTree(BitReader& reader, Node* root, TraceLogger* logger) {
        if (!root) return -1;
        if (root->isLeaf()) return root->symbol;
        Node* curr = root;
        while (!curr->isLeaf()) {
            int bit = 0;
            if (!reader.readBit(bit)) return -1;
            Node* next = (bit == 0) ? curr->left : curr->right;
            if (!next) return -1;
            if (logger && logger->enabled) {
