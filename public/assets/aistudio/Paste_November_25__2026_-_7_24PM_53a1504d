<script>
const state = {
  events: [],
  treeNodes: [],
  hexBytes: [],
  codes: [],
  curStep: 0,
  timer: null,
  frames: []
};

function switchTab(id, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + id).classList.add('active');
  btn.classList.add('active');
}

function applyXrayPreset() {
  const v = document.getElementById('xrayPreset').value;
  const el = document.getElementById('xrayInput');
  if (v === 'custom') el.value = 'AAAABBBBCCCCDDDDEEEEE';
  else if (v === 'logs') el.value = '2026-11-25T14:02:11Z [ERROR] ip=10.24.18.12 path=/api/v2/auth status=502 msg="timeout"\n2026-11-25T14:02:12Z [ERROR] ip=10.24.18.12 path=/api/v2/auth status=502 msg="timeout"\n';
  else if (v === 'dna') el.value = '>CHR_001\nATCGATCGATCGTAGCTAGCTA\nATCGATCGATCGTAGCTAGCTA\n';
  else if (v === 'json') el.value = '[{"id":"s1","temp":22.5,"ok":true},{"id":"s1","temp":22.5,"ok":true}]';
}

async function runXray() {
  stopPlay();
  const text = document.getElementById('xrayInput').value;
  const mode = parseInt(document.getElementById('xrayMode').value, 10);
  const res = await fetch('/api/xray', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ text, mode, allowBypass: 0 })
  });
  const data = await res.json();
  const st = data.stats;

  document.getElementById('mOrig').textContent = st.originalSize + ' B';
  document.getElementById('mComp').textContent = st.compressedSize + ' B';
  document.getElementById('mRatio').textContent = st.ratioPercent.toFixed(1) + '%';
  document.getElementById('mCrc').textContent = st.crc32Hex;
  const vEl = document.getElementById('mVerify');
  vEl.textContent = (st.crcVerified && st.roundtripMatch) ? 'PASS (100%)' : 'FAIL';
  vEl.className = 'v ' + ((st.crcVerified && st.roundtripMatch) ? 'ok' : 'bad');

  state.treeNodes = data.trace.treeNodes || [];
  state.hexBytes = data.trace.hexBytes || [];
  state.codes = data.trace.codes || [];
  state.events = data.trace.events || [];
  document.getElementById('mEvents').textContent = state.events.length;

  buildFrames();
  renderCodeTable();

  const scrubber = document.getElementById('scrubber');
  scrubber.max = Math.max(0, state.events.length - 1);
  stepTo(0);
}

// Precompute cumulative frame states for instant O(1) time-travel forward & backward
function buildFrames() {
  state.frames = [];
  let heap = [];
  const mergedIds = new Set();
  let bitBuffer = 0;
  let bitCount = 0;
  let flushedCount = 0;

  for (let i = 0; i < state.events.length; i++) {
    const ev = state.events[i];
    if (ev.type === 'HEAP_INIT' || ev.type === 'HEAP_SWAP') {
      heap = ev.heap || [];
    } else if (ev.type === 'EXTRACT_MERGE') {
      heap = ev.heap || [];
      mergedIds.add(ev.parentId);
    } else if (ev.type === 'BIT_PUSH') {
      bitBuffer = ev.bitBuffer;
      bitCount = ev.bitCount;
    } else if (ev.type === 'BIT_FLUSH') {
      bitBuffer = 0;
      bitCount = 0;
      flushedCount++;
    }
    state.frames.push({
      heap: heap.slice(),
      mergedSet: new Set(mergedIds),
      bitBuffer,
      bitCount,
      flushedCount
    });
  }
}

function stepTo(idx) {
  if (state.events.length === 0) return;
  idx = Math.max(0, Math.min(idx, state.events.length - 1));
  state.curStep = idx;
  document.getElementById('scrubber').value = idx;
  document.getElementById('stepCounter').textContent = (idx + 1) + ' / ' + state.events.length;

  const ev = state.events[idx];
  const fr = state.frames[idx];
  document.getElementById('eventDetail').textContent = ev.detail;
  document.getElementById('eventTag').textContent = ev.type;

  renderHeap(fr.heap, ev);
  renderTree(fr.mergedSet, ev);
  renderBitRegister(fr.bitBuffer, fr.bitCount, ev);
  renderHexDump(fr.flushedCount);
}

function stepDelta(d) { stepTo(state.curStep + d); }

function togglePlay() {
  if (state.timer) { stopPlay(); return; }
  if (state.curStep >= state.events.length - 1) stepTo(0);
  document.getElementById('playBtn').textContent = 'Pause';
  const delay = parseInt(document.getElementById('speedSel').value, 10);
  state.timer = setInterval(() => {
    if (state.curStep >= state.events.length - 1) { stopPlay(); return; }
    stepDelta(1);
  }, delay);
}

function stopPlay() {
  if (state.timer) { clearInterval(state.timer); state.timer = null; }
  document.getElementById('playBtn').textContent = 'Play';
}

function renderHeap(heap, ev) {
  const grid = document.getElementById('heapGrid');
  document.getElementById('heapSizeLabel').textContent = 'size: ' + heap.length;
  grid.innerHTML = heap.map((item, i) => {
    let cls = 'heap-slot';
    if (ev.type === 'HEAP_SWAP' && (i === ev.idxA || i === ev.idxB)) cls += ' swap';
    if (ev.type === 'EXTRACT_MERGE' && item.id === ev.parentId) cls += ' merge';
    return `<div class="${cls}">
      <div class="idx">[${i}] #${item.id}</div>
      <div class="sym mono">${escapeHtml(item.lbl)}</div>
      <div class="frq">f=${item.freq}</div>
    </div>`;
  }).join('');
}

function renderTree(mergedSet, ev) {
  const svg = document.getElementById('treeSvg');
  if (state.treeNodes.length === 0) {
    svg.innerHTML = '<text x="380" y="180" fill="#8b9bb4" text-anchor="middle" font-size="13">No static tree nodes for this mode.</text>';
    return;
  }
  const byId = new Map();
  state.treeNodes.forEach(n => byId.set(n.id, n));

  // Determine roots of currently merged forest (or full tree during DECODE_STEP)
  const isDecode = ev.type === 'DECODE_STEP' || ev.type === 'BIT_PUSH' || ev.type === 'BIT_FLUSH';
  const visibleNodes = new Set();
  const hasParent = new Set();
  state.treeNodes.forEach(n => {
    if (n.isLeaf || isDecode || mergedSet.has(n.id)) {
      visibleNodes.add(n.id);
      if (n.leftId > 0 && (isDecode || mergedSet.has(n.id))) hasParent.add(n.leftId);
      if (n.rightId > 0 && (isDecode || mergedSet.has(n.id))) hasParent.add(n.rightId);
    }
  });

  const roots = [];
  visibleNodes.forEach(id => {
    const n = byId.get(id);
    if (!hasParent.has(id) && n) roots.push(n);
  });

  // Layout tree(s) cleanly left-to-right using leaf count
  function countLeaves(n) {
    if (!n || n.isLeaf || (!isDecode && !mergedSet.has(n.id))) return 1;
    return countLeaves(byId.get(n.leftId)) + countLeaves(byId.get(n.rightId));
  }

  const totalLeaves = roots.reduce((s, r) => s + countLeaves(r), 0) || 1;
  const pos = new Map();
  let xCursor = 0;

  function layout(n, depth) {
    if (!n) return 0;
    const expanded = !n.isLeaf && (isDecode || mergedSet.has(n.id));
    let cx;
    if (!expanded) {
      cx = ((xCursor + 0.5) / totalLeaves) * 720 + 20;
      xCursor++;
    } else {
      const lx = layout(byId.get(n.leftId), depth + 1);
      const rx = layout(byId.get(n.rightId), depth + 1);
      cx = (lx + rx) / 2;
    }
    const cy = 32 + depth * 52;
    pos.set(n.id, { x: cx, y: Math.min(cy, 330), n, expanded });
    return cx;
  }
  roots.forEach(r => layout(r, 0));

  let html = '';
  pos.forEach(({ x, y, n, expanded }) => {
    if (!expanded) return;
    [ [n.leftId, '0'], [n.rightId, '1'] ].forEach(([cid, bitLbl]) => {
      const cp = pos.get(cid);
      if (!cp) return;
      const activeEdge = (ev.type === 'DECODE_STEP' && ev.fromId === n.id && ev.toId === cid);
      const stroke = activeEdge ? '#fbbf24' : '#334155';
      const sw = activeEdge ? 3 : 1.5;
      html += `<line x1="${x}" y1="${y}" x2="${cp.x}" y2="${cp.y}" stroke="${stroke}" stroke-width="${sw}"/>`;
      html += `<text x="${(x + cp.x) / 2}" y="${(y + cp.y) / 2 - 3}" fill="${activeEdge ? '#fbbf24' : '#64748b'}" font-size="10" text-anchor="middle">${bitLbl}</text>`;
    });
  });

  pos.forEach(({ x, y, n }) => {
    const isMerged = (ev.type === 'EXTRACT_MERGE' && (n.id === ev.parentId || n.id === ev.leftId || n.id === ev.rightId));
    const isDecodeTarget = (ev.type === 'DECODE_STEP' && n.id === ev.toId);
    const fill = isDecodeTarget ? '#fbbf24' : (isMerged ? '#34d399' : (n.isLeaf ? '#0ea5e9' : '#1e293b'));
    const textCol = (isDecodeTarget || isMerged) ? '#0b0f17' : '#f8fafc';
    const r = n.isLeaf ? 15 : 13;
    html += `<circle cx="${x}" cy="${y}" r="${r}" fill="${fill}" stroke="#475569" stroke-width="1.5"/>`;
    const lbl = n.isLeaf ? n.label : ('#' + n.id);
    html += `<text x="${x}" y="${y + 4}" fill="${textCol}" font-size="10" font-weight="700" text-anchor="middle">${escapeHtml(lbl)}</text>`;
  });
  svg.innerHTML = html;
}

function renderBitRegister(bitBuffer, bitCount, ev) {
  const reg = document.getElementById('bitReg');
  const hex = '0x' + bitBuffer.toString(16).toUpperCase().padStart(2, '0');
  document.getElementById('bitBufferHex').textContent = `${hex} (${bitCount}/8 bits)`;

  let html = '';
  for (let i = 7; i >= 0; i--) {
    const active = i < bitCount;
    const val = active ? ((bitBuffer >> i) & 1) : 0;
    const isNewest = (ev.type === 'BIT_PUSH' && i === 0 && bitCount > 0);
    let cls = 'bit-cell';
    if (isNewest) cls += ' newest';
    else if (active) cls += ' filled';
    html += `<div class="${cls} mono">${active ? val : '&middot;'}<small>b${i}</small></div>`;
  }
  reg.innerHTML = html;
}

function renderHexDump(flushedCount) {
  const dump = document.getElementById('hexDump');
  const limit = Math.min(state.hexBytes.length, 512);
  let html = '';
  for (let i = 0; i < limit; i++) {
    const hb = state.hexBytes[i];
    const hex = hb.v.toString(16).toUpperCase().padStart(2, '0');
    const isCursor = (flushedCount > 0 && i === flushedCount - 1);
    html += `<span class="hex-byte sec-${hb.s}${isCursor ? ' cursor' : ''}" title="[${i}] ${hb.s}: 0x${hex}">${hex}</span>`;
  }
  if (state.hexBytes.length > limit) {
    html += `<span class="muted">... +${state.hexBytes.length - limit} more bytes</span>`;
  }
  dump.innerHTML = html;
}

function renderCodeTable() {
  const tb = document.getElementById('codeTableBody');
  const sorted = state.codes.slice().sort((a, b) => a.code.length - b.code.length || a.symbol - b.symbol);
  tb.innerHTML = sorted.map(c => `<tr>
    <td class="mono" style="color:var(--cyan);font-weight:700;">${escapeHtml(c.label)}</td>
    <td>${c.freq}</td>
    <td>${c.code.length}</td>
    <td class="mono" style="color:var(--emerald);">${c.code}</td>
  </tr>`).join('');
}

async function runBenchmark() {
  const preset = document.getElementById('benchPreset').value;
  const sizeKB = parseInt(document.getElementById('benchSize').value, 10);
  const customText = document.getElementById('benchCustom').value;
  const res = await fetch('/api/benchmark', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ preset, sizeKB, customText })
  });
  const data = await res.json();
  document.getElementById('benchDatasetLabel').textContent = data.dataset;

  document.getElementById('benchBody').innerHTML = data.rows.map(r => {
    const barW = Math.min(100, Math.max(2, r.ratioPercent));
    const ok = r.crcVerified && r.roundtripMatch;
    return `<tr>
      <td><strong>${escapeHtml(r.modeName)}</strong>${r.bypassRecommended ? ' <span class="badge" style="color:var(--amber);border-color:var(--amber);">Bypass Adv.</span>' : ''}</td>
      <td>${r.originalSize.toLocaleString()} B</td>
      <td class="mono"><strong>${r.compressedSize.toLocaleString()} B</strong></td>
      <td>${r.headerOverhead} B</td>
      <td class="${r.ratioPercent < 100 ? 'ok' : 'warn'}"><strong>${r.ratioPercent.toFixed(2)}%</strong></td>
      <td style="min-width:140px;"><div class="bar-track"><div class="bar-fill" style="width:${barW}%"></div></div></td>
      <td>${r.compressMs.toFixed(2)}</td>
      <td>${r.decompressMs.toFixed(2)}</td>
      <td class="${ok ? 'ok' : 'bad'} mono">${r.crc32} ${ok ? 'PASS' : 'FAIL'}</td>
    </tr>`;
  }).join('');
}

function escapeHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// Auto-run initial X-Ray trace on load
window.addEventListener('DOMContentLoaded', () => runXray());
</script>
</body>
</html>
